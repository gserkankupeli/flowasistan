# Committed on purpose: no secrets here.
# Every production build (Vercel) runs as the public demo on fictional in-browser data,
# with no Supabase connection. To ship the real app instead, set VITE_DEMO_MODE=false
# together with the Supabase variables in the hosting environment. Do that only after
# the Row Level Security policies in supabase/schema.sql are restricted to signed-in users.
VITE_DEMO_MODE=true
